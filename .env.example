# Copy this file to .env (or .env.local) and fill in real values. Never commit them.
# .env.local overrides .env. POSTGRES_URL also works in place of DATABASE_URL.
PORT=3001
DATABASE_URL=
TEST_DATABASE_URL=
# Front-end sites allowed to call the API from a browser, comma-separated.
# http://localhost:<any port> is always allowed.
CORS_ORIGINS=
# Signs login tokens. At least 32 characters, random, never shared or committed.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use a different value in production (e.g. Vercel's env vars).
JWT_SECRET=
