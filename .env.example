# Copy this file to .env (or .env.local) and fill in real values. Never commit them.
# .env.local overrides .env. POSTGRES_URL also works in place of DATABASE_URL.
PORT=3000
DATABASE_URL=
TEST_DATABASE_URL=
# Front-end sites allowed to call the API from a browser, comma-separated.
# http://localhost:<any port> is always allowed.
CORS_ORIGINS=
